{
   "name": "v5.chriskrycho.com",
   "version": "1.0.0",
   "description": "The fifth version of chriskrycho.com.",
   "license": "MIT",
   "author": "Chris Krycho <hello@chriskrycho.com>",
   "repository": "https://github.com/chriskrycho/v5.chriskrycho.com",
   "type": "module",
   "main": "index.js",
   "scripts": {
      "build:styles": "sass --style=compressed --source-map site/_includes/styles/style.scss:site/_styles/style.css site/_includes/styles/fonts.scss:site/_styles/fonts.css site/_includes/styles/print.scss:site/_styles/print.css",
      "build:site": "eleventy --config=eleventy.config.ts --quiet",
      "build:scripts": "rolldown -c rolldown.config.mjs",
      "build": "npm run build:scripts && npm run build:styles && npm run build:site",
      "watch:styles": "sass --watch --style=compressed --source-map site/_includes/styles/style.scss:site/_styles/style.css site/_includes/styles/fonts.scss:site/_styles/fonts.css site/_includes/styles/print.scss:site/_styles/print.css",
      "watch:site": "eleventy --config=eleventy.config.ts --serve",
      "watch:scripts": "rolldown --config rolldown.config.mjs --watch",
      "serve": "env DEV=true eleventy --config=eleventy.config.ts --quiet --serve --incremental",
      "clean": "rm -rf public"
   },
   "devDependencies": {
      "@11ty/eleventy": "^3.1.6",
      "@types/common-tags": "^1.8.4",
      "@types/js-yaml": "^4.0.9",
      "@types/linkify-it": "3.0.5",
      "@types/luxon": "^3.7.1",
      "@types/markdown-it": "^12.2.3",
      "@types/markdown-it-container": "^2.0.11",
      "@types/node": "^16.18.126",
      "@types/serve-static": "^1.15.10",
      "@types/uslug": "^1.0.4",
      "common-tags": "^1.8.2",
      "gray-matter": "^4.0.3",
      "highlight.js": "^11.11.1",
      "highlightjs-glimmer": "^2.2.2",
      "js-yaml": "^5.2.2",
      "luxon": "^3.7.2",
      "markdown-it": "^14.2.0",
      "markdown-it-abbr": "^1.0.4",
      "markdown-it-anchor": "^8.6.7",
      "markdown-it-deflist": "^2.1.0",
      "markdown-it-footnote": "^3.0.3",
      "markdown-it-implicit-figures": "^0.10.0",
      "markdown-it-mark": "^3.0.1",
      "markdown-it-sup": "^1.0.0",
      "oxfmt": "^0.60.0",
      "rolldown": "^1.1.0",
      "sass": "^1.100.0",
      "striptags": "^3.2.0",
      "true-myth": "^9.4.0",
      "typescript": "^7.0.2",
      "typeset": "^0.3.5",
      "uslug": "^1.0.4"
   }
}
