---
standalonePage: true
---

{% extends 'base.njk' %}
{% import 'components/item.njk' as item %}
{% import 'components/archive-list.njk' as archive %}
{% from 'components/social.njk' import meta %}

{%- block meta %}
{{ meta(collections.all | current(page), config) }}
{%- endblock meta %}

{%- block main -%}
<section class='content-block'>
{{item.header(type='archive', title=title, subtitle=subtitle, subscribe=subscribe)}}

{%- if content -%}
<article class='content-block post'>
   {% block header -%}{%- endblock header %}
   {% block before_content %}{% endblock before_content %}
   <div class='article-content'>
      {% block content -%}
      {% if qualifiers -%}
      {%- if qualifiers.retraction -%}
         <div class='retraction' aria-label='Retraction'>
         {{- qualifiers.retraction | safe -}}
         </div>
      {%- endif -%}

      <div class='qualifiers'>
         {%- if qualifiers.audience -%}
            {{- qualifiers.audience | safe -}}
         {%- endif -%}
         {%- if qualifiers.disclosure -%}
            {{- qualifiers.disclosure | safe -}}
         {%- endif -%}
         {%- if qualifiers.context -%}
            {{- qualifiers.context | safe -}}
         {%- endif -%}
         {%- if qualifiers.epistemic -%}
            {{- qualifiers.epistemic | safe -}}
         {%- endif -%}
         {%- if qualifiers.discusses -%}
            {{- qualifiers.discusses | safe -}}
         {%- endif -%}
      </div>
      {%- endif %}

      {{content | safe}}
      {%- endblock content %}
   </div>
   {% block after_content %}{% endblock after_content %}
</article>
{%- endif -%}

{%- set c = page.inputPath | toCollection(isGhostCollection) -%}
{%- set order = order if order else 'NEW_FIRST' -%}
{%- if collections[c] -%}
   {%-
      set items = collections[c]
         | excludingStandalonePages
         | excludingFeedOnly
         | archiveByYears(order)
   -%}
   {{ archive.list(items) }}
{%- endif -%}
</section>
{%- endblock main -%}
