{
   "$schema": "https://json.schemastore.org/tsconfig",
   "compilerOptions": {
      /* Basic Options */
      "target": "ES2025",
      "lib": ["ES2025"],
      "checkJs": true,
      "allowJs": true,
      "moduleResolution": "nodenext",
      "module": "node20",
      /* Strict Type-Checking Options */
      "strict": true,
      "noUncheckedIndexedAccess": true,

      /* Additional Checks */
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,

      /* Module Resolution Options */
      "paths": {
         // markdown-it-anchor@10's declaration uses the legacy CommonJS type
         // shape and private markdown-it/lib/* paths; route only its types through
         // our v15-compatible declaration using public package-root types.
         "markdown-it-anchor": ["./types/markdown-it-anchor.d.ts"],
         "*": ["./*", "./types/*"],
      },
   },
}
